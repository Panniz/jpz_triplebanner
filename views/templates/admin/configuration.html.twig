{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% trans_default_domain 'Modules.Jpztriplebanner.Admin' %}

{% block content %}
  {{ form_start(configurationForm, {attr: {class: 'jpz-banner-configuration'}}) }}

  {% for name, preview in previews %}
    {% set bannerForm = configurationForm[name] %}
    <div class="card">
      <h3 class="card-header">
        <i class="material-icons">image</i>
        {{ 'Banner %number%'|trans({'%number%': loop.index}) }}
      </h3>
      <div class="card-body">
        <div class="form-wrapper">
          {% for variant in ['desktop', 'mobile'] %}
            {{ form_row(bannerForm['image_' ~ variant]) }}
            {% if preview[variant] %}
              <div class="form-group row">
                <label class="form-control-label"></label>
                <div class="col-sm">
                  <img src="{{ preview[variant] }}" alt="" class="img-thumbnail mb-2" style="max-height: 120px;" loading="lazy">
                  {{ form_widget(bannerForm['remove_image_' ~ variant]) }}
                </div>
              </div>
            {% else %}
              {% do bannerForm['remove_image_' ~ variant].setRendered() %}
            {% endif %}
          {% endfor %}

          {{ form_row(bannerForm.text) }}
          {{ form_row(bannerForm.category) }}
          {{ form_row(bannerForm.query_params) }}
        </div>
      </div>
    </div>
  {% endfor %}

  <div class="card">
    <div class="card-footer">
      <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'Admin.Actions') }}</button>
      </div>
    </div>
  </div>

  {{ form_end(configurationForm) }}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    $(() => {
      // TranslatableType riporta la classe autoload_rte anche sul contenitore della
      // lingua: tolta da lì, l'editor parte una volta sola, sulla textarea.
      document.querySelectorAll('.js-locale-input.autoload_rte').forEach((el) => el.classList.remove('autoload_rte'));
      window.prestashop.component.initComponents(['TranslatableField', 'TranslatableInput', 'TinyMCEEditor']);
    });
  </script>
{% endblock %}
